# node scripts/dev.mjs init generates a private .env without overwriting existing secrets.
CRYPTO_KEY=
ADMIN_EMAIL=admin@localhost.example
ADMIN_PASSWORD=
ALLOWED_HOSTS=localhost;127.0.0.1
DATABASE_HOST=host.docker.internal
FRONTEND_PORT=8443
# Change these three together if the subnet conflicts with an existing Docker network.
WEB_SUBNET=172.30.85.0/24
WEB_DYNAMIC_RANGE=172.30.85.128/25
FRONTEND_IP=172.30.85.2
DEV_API_URL=http://127.0.0.1:5080

# Local database targets. Their TLS is not configured; use TLS=false only for local testing.
POSTGRES_PORT=55432
POSTGRES_DATABASE=octobackup_demo
POSTGRES_USER=backup
POSTGRES_PASSWORD=
MYSQL_PORT=53306
MYSQL_DATABASE=octobackup_demo
MYSQL_USER=backup
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Optional profile: docker compose -f compose.dbs.yaml --profile sqlserver up -d
MSSQL_PORT=51433
MSSQL_SA_PASSWORD=
