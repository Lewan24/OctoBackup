{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AuthSettings": {
    "AutoConfirmAccount": true,
    "EnableRegisterModule": true
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "AllowInsecureHttp": false,
    "AllowedDatabaseHosts": [
      "10.0.121.6"
    ]
  },
  "Hosting": {
    "ServeFrontend": false
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "CRYPTO_KEY": null,
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Storage": {
    "DataDirectory": null
  },
  "Ssh": {
    "HostKeysFile": null
  },
  "Development": {
    "AutoProvisionLocalSettings": false
  },
  "RestoreTests": {
    "Enabled": false,
    "Automatic": false,
    "PostgresImage": "postgres:16-bookworm",
    "MySqlImage": "mysql:8.4",
    "MariaDbImage": "mariadb:11.4",
    "PostgresImages": {
      "14": "postgres:14",
      "15": "postgres:15",
      "16": "postgres:16-bookworm",
      "17": "postgres:17",
      "18": "postgres:18-alpine"
    },
    "MySqlImages": {
      "5.7": "mysql:5.7",
      "8.0": "mysql:8.0",
      "8.4": "mysql:8.4",
      "9.6": "mysql:9.6"
    },
    "MariaDbImages": {
      "10.11": "mariadb:10.11",
      "11.4": "mariadb:11.4"
    },
    "SqlServerImage": "mcr.microsoft.com/mssql/server:2022-latest",
    "TimeoutSeconds": 1800,
    "MemoryMiB": 4096,
    "DataGiB": 4,
    "MaxArchiveGiB": 10
  },
  "Backups": {
    "DefaultRetentionDays": 4,
    "SchedulePollSeconds": 300,
    "QueueDelaySeconds": 20,
    "QueueSpacingSeconds": 5
  },
  "DataProtection": {
    "KeysDirectory": null
  },
  "Sqlite": {
    "SourceDirectory": null,
    "RestoreTestsEnabled": true
  },
  "SqlServer": {
    "RemoteBackupRoot": null,
    "LocalStagingDirectory": null
  },
  "DatabaseTools": {
    "MySqlDumpPath": null,
    "PostgresDumpPath": null
  }
}
