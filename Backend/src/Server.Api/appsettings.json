{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AuthSettings": {
    "AutoConfirmAccount": true,
    "EnableRegisterModule": true
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "AllowedDatabaseHosts": ["10.0.121.6"]
  },
  "Hosting": {
    "ServeFrontend": false
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "CRYPTO_KEY": null,
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Storage": {
    "DataDirectory": null
  },
  "Ssh": {
    "HostKeysFile": null
  },
  "Development": {
    "AutoProvisionLocalSettings": false
  },
  "Backups": {
    "DefaultRetentionDays": 4,
    "SchedulePollSeconds": 300,
    "QueueDelaySeconds": 20,
    "QueueSpacingSeconds": 5
  }
}
