{
  "Security": {
    "AllowedDatabaseHosts": [
      "localhost",
      "127.0.0.1",
      "host.docker.internal"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Urls": "http://127.0.0.1:5080",
  "Storage": {
    "DataDirectory": "../../data"
  },
  "Ssh": {
    "HostKeysFile": "../../../certs/ssh-host-keys.json"
  },
  "Development": {
    "AutoProvisionLocalSettings": true
  }
}
